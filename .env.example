# Copy this file to .env and enter your local MySQL settings. Never commit .env.
SECRET_KEY=generate-a-long-random-secret
# Set these only for authorized staff onboarding; leave blank to disable elevated-role self-registration.
ADMIN_REGISTRATION_CODE=
DEPARTMENT_REGISTRATION_CODE=
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_NAME=civic_sync

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
